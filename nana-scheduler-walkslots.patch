+/* STATUS: RECONSTRUCTED (manual MIPS decode; Ghidra decompile comparison pending)
+ * ADDRESS: 0x00177140
+ * PURPOSE: advance the deferred-callback job state machine once per frame.
+ *          The global context starts at 0x007D1FC0; the current job vtable is
+ *          read through job+0x50. */
+void Schedule__WalkSlots(void)
+{
+    Schedule__Job *job = (Schedule__Job *)(u32)g_CurrentJob;
+    s32 local_out;
+    s32 result;
+
+    if (job == 0) {
+        return;
+    }
+
+    g_JobFrames++;
+    result = job->vtable->method_3C(job, 0);
+
+    switch ((s32)g_JobState) {
+    case 1:
+        if (result != 2) {
+            return;
+        }
+        if (Job__Poll() != 0) {
+            return;
+        }
+
+        job->vtable->method_30(job,
+                               *(s32 *)0x007D1FCC,
+                               *(s32 *)0x007D1FD0);
+        g_JobState = 2;
+        Schedule__Kick(6);
+        break;
+
+    case 2:
+        break;
+
+    case 3:
+        if (Job__Poll() != 0) {
+            return;
+        }
+
+        job->vtable->method_2C(job);
+        g_CurrentJob = 0;
+        g_JobCb = 0;
+        g_JobCbArg = 0;
+        *(s32 *)0x007D1FCC = 0;
+        *(s32 *)0x007D1FD0 = 0;
+        g_JobState = 0;
+        Schedule__Kick(6);
+        fcn_00177EB0();
+        break;
+
+    case 4:
+        if (g_JobFrames < 30) {
+            return;
+        }
+        if (Job__Poll() != 0) {
+            return;
+        }
+
+        job->vtable->method_2C(job);
+        g_JobFrames = 0;
+        g_JobState = 5;
+        break;
+
+    case 5:
+        if (g_JobFrames < 30) {
+            return;
+        }
+        if (Job__Poll() != 0) {
+            return;
+        }
+
+        g_CurrentJob = Job__Create(0x007D1FD4,
+                                   0x11,
+                                   0x00176DF0,
+                                   0);
+        Schedule__Kick(6);
+
+        job = (Schedule__Job *)(u32)g_CurrentJob;
+        if (job == 0) {
+            return;
+        }
+
+        job->vtable->method_38(job,
+                               (s32)&local_out,
+                               *(s32 *)0x007D20D4,
+                               1);
+        g_JobFrames = 0;
+        g_JobState = 1;
+        break;
+
+    default:
+        break;
+    }
